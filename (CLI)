import json
import argparse
import sys
from pathlib import Path
from datetime import datetime

DATA_FILE = Path(__file__).with_name("tasks.json")


# ---------- Almacenamiento ----------

def load_tasks():
    if not DATA_FILE.exists():
        return []

    try:
        with open(DATA_FILE, "r", encoding="utf-8") as file:
            data = json.load(file)
        if not isinstance(data, list):
            raise ValueError("Formato inválido")
        return data
    except (json.JSONDecodeError, ValueError):
        backup = DATA_FILE.with_suffix(".json.bak")
        DATA_FILE.replace(backup)
        print(f"El archivo de tareas estaba dañado. Copia guardada en {backup.name}.")
        return []
    except OSError as error:
        sys.exit(f"No se pudo leer el archivo de tareas: {error}")


def save_tasks(tasks):
    temp_file = DATA_FILE.with_suffix(".json.tmp")
    try:
        with open(temp_file, "w", encoding="utf-8") as file:
            json.dump(tasks, file, indent=4, ensure_ascii=False)
        temp_file.replace(DATA_FILE)
    except OSError as error:
        sys.exit(f"No se pudo guardar las tareas: {error}")


def find_task(tasks, task_id):
    for task in tasks:
        if task["id"] == task_id:
            return task
    return None


# ---------- Comandos ----------

def list_tasks(tasks, show="all"):
    if show == "pending":
        tasks = [t for t in tasks if not t["done"]]
    elif show == "done":
        tasks = [t for t in tasks if t["done"]]

    if not tasks:
        print("No hay tareas para mostrar.")
        return

    print("\n===== MIS TAREAS =====")
    for task in tasks:
        status = "Completada" if task["done"] else "Pendiente"
        created = task.get("created_at", "")[:10]
        print(f'{task["id"]}. [{status}] {task["title"]}  ({created})')
    print("======================\n")


def add_task(tasks, title):
    title = title.strip()
    if not title:
        print("Error: El título no puede estar vacío.")
        return

    next_id = max((task["id"] for task in tasks), default=0) + 1

    task = {
        "id": next_id,
        "title": title,
        "done": False,
        "created_at": datetime.now().isoformat(timespec="seconds"),
        "completed_at": None,
    }

    tasks.append(task)
    save_tasks(tasks)
    print(f"Tarea agregada (#{next_id}): {title}")


def complete_task(tasks, task_id):
    task = find_task(tasks, task_id)
    if not task:
        print(f"No se encontró ninguna tarea con el ID {task_id}.")
        return

    if task["done"]:
        print("Esa tarea ya estaba completada.")
        return

    task["done"] = True
    task["completed_at"] = datetime.now().isoformat(timespec="seconds")
    save_tasks(tasks)
    print(f'Tarea completada: {task["title"]}')


def reopen_task(tasks, task_id):
    task = find_task(tasks, task_id)
    if not task:
        print(f"No se encontró ninguna tarea con el ID {task_id}.")
        return

    if not task["done"]:
        print("Esa tarea ya está pendiente.")
        return

    task["done"] = False
    task["completed_at"] = None
    save_tasks(tasks)
    print(f'Tarea reabierta: {task["title"]}')


def edit_task(tasks, task_id, new_title):
    new_title = new_title.strip()
    if not new_title:
        print("Error: El nuevo título no puede estar vacío.")
        return

    task = find_task(tasks, task_id)
    if not task:
        print(f"No se encontró ninguna tarea con el ID {task_id}.")
        return

    task["title"] = new_title
    save_tasks(tasks)
    print(f"Tarea #{task_id} actualizada: {new_title}")


def delete_task(tasks, task_id):
    task = find_task(tasks, task_id)
    if not task:
        print(f"No se encontró ninguna tarea con el ID {task_id}.")
        return

    tasks.remove(task)
    save_tasks(tasks)
    print(f"Tarea #{task_id} eliminada.")


def search_tasks(tasks, text):
    query = text.lower()
    results = [t for t in tasks if query in t["title"].lower()]

    if not results:
        print(f"No se encontraron tareas que coincidan con: '{text}'")
        return

    list_tasks(results)


def clear_completed(tasks):
    remaining = [t for t in tasks if not t["done"]]
    removed = len(tasks) - len(remaining)

    if removed == 0:
        print("No hay tareas completadas para eliminar.")
        return

    save_tasks(remaining)
    print(f"Se eliminaron {removed} tarea(s) completada(s).")


def show_stats(tasks):
    total = len(tasks)
    done = sum(1 for t in tasks if t["done"])
    pending = total - done
    percent = (done / total * 100) if total else 0

    print(f"\nEstadísticas: Total: {total} | Completadas: {done} | Pendientes: {pending} | Progreso: {percent:.0f}%\n")


# ---------- Programa principal ----------

def main():
    parser = argparse.ArgumentParser(
        description="Gestor de tareas desarrollado en Python."
    )

    commands = parser.add_subparsers(dest="command", required=True)

    # Listar
    list_parser = commands.add_parser("list", help="Mostrar tareas (todas, pendientes o completadas)")
    list_group = list_parser.add_mutually_exclusive_group()
    list_group.add_argument("--pending", action="store_true", help="Mostrar solo tareas pendientes")
    list_group.add_argument("--done", action="store_true", help="Mostrar solo tareas completadas")

    # Agregar
    add_parser = commands.add_parser("add", help="Agregar una nueva tarea")
    add_parser.add_argument("title", help="Título o descripción de la tarea")

    # Completar
    complete_parser = commands.add_parser("complete", help="Marcar una tarea como completada")
    complete_parser.add_argument("id", type=int, help="ID de la tarea")

    # Reabrir
    reopen_parser = commands.add_parser("reopen", help="Marcar una tarea completada como pendiente de nuevo")
    reopen_parser.add_argument("id", type=int, help="ID de la tarea")

    # Editar
    edit_parser = commands.add_parser("edit", help="Modificar el título de una tarea existente")
    edit_parser.add_argument("id", type=int, help="ID de la tarea")
    edit_parser.add_argument("title", help="Nuevo título para la tarea")

    # Eliminar
    delete_parser = commands.add_parser("delete", help="Eliminar una tarea específica por su ID")
    delete_parser.add_argument("id", type=int, help="ID de la tarea")

    # Buscar
    search_parser = commands.add_parser("search", help="Buscar tareas que contengan un texto específico")
    search_parser.add_argument("text", help="Texto de búsqueda")

    # Limpiar completadas
    commands.add_parser("clear", help="Eliminar todas las tareas que ya están completadas")

    # Estadísticas
    commands.add_parser("stats", help="Mostrar estadísticas de progreso")

    args = parser.parse_args()
    tasks = load_tasks()

    if args.command == "list":
        show = "pending" if args.pending else "done" if args.done else "all"
        list_tasks(tasks, show)
    elif args.command == "add":
        add_task(tasks, args.title)
    elif args.command == "complete":
        complete_task(tasks, args.id)
    elif args.command == "reopen":
        reopen_task(tasks, args.id)
    elif args.command == "edit":
        edit_task(tasks, args.id, args.title)
    elif args.command == "delete":
        delete_task(tasks, args.id)
    elif args.command == "search":
        search_tasks(tasks, args.text)
    elif args.command == "clear":
        clear_completed(tasks)
    elif args.command == "stats":
        show_stats(tasks)


if __name__ == "__main__":
    main()
